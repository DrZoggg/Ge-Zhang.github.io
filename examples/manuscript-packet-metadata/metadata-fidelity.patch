+
+def _metadata_assertion(source: dict[str, Any]) -> dict[str, Any]:
+    assertion = {key: source[key] for key in METADATA_FIELDS
+                 if key in source and source[key] not in (None, "", [])}
+    return {"url": str(source.get("url") or ""), **assertion} if assertion else {}
+
+
+def _metadata_values(source: dict[str, Any], field: str) -> list[Any]:
+    assertions = source.get("_metadata_assertions") or [source]
+    values = []
+    for assertion in assertions:
+        value = assertion.get(field)
+        values.extend(value if isinstance(value, (list, tuple)) else [value])
+    return values
+
+
+def metadata_conflicts(source: dict[str, Any]) -> dict[str, Any]:
+    """Expose incompatible supplied assertions instead of choosing the last one."""
+    assertions = source.get("_metadata_assertions") or [_metadata_assertion(source)]
+    types = _metadata_types(_metadata_values(source, "publication_type"))
+    genres = {key for _, key in types if key in GENRES
+              and key not in {"journal article", "primary/other", "unknown"}}
+    designs = {key for _, key in _metadata_types(_metadata_values(source, "study_design"), design=True)
+               if key != "unknown"}
+    designs.update(key for _, key in types if key in EVIDENCE_WEIGHTS and key not in GENRES)
+    if "randomized controlled trial" in designs:
+        designs.discard("clinical trial")  # A generic trial tag can coexist with its RCT subtype.
+    grades = {value.strip().casefold() for value in _metadata_values(source, "evidence_quality")
+              if isinstance(value, str) and value.strip().casefold() in
+              {"high", "moderate", "contextual", "low", "exclude"}}
+    return {field: assertions for field, values in (
+        ("publication_type", genres), ("study_design", designs), ("evidence_quality", grades)
+    ) if len(values) > 1}
+
+
+def classification_fields(source: dict[str, Any], text: str) -> tuple[str, str, str]:
+    """Publication genre and research design are independent, including Letters."""
+    supplied = _metadata_types(_metadata_values(source, "publication_type"))
+    # PubMed-style arrays commonly contain generic Journal Article plus Letter.
+    specific = [item for item in supplied if item[1] in GENRES
+                and item[1] not in {"journal article", "primary/other", "unknown"}]
+    publication = next(iter(specific or supplied), None)
+    design = next(iter(_metadata_types(_metadata_values(source, "study_design"), design=True)), None)
+    if not design:
+        design = next((item for item in supplied if item[1] in EVIDENCE_WEIGHTS
+                       and item[1] not in GENRES), None)
+    inferred_design = _text_design(text)
+    genre = publication[1] if publication else _text_genre(text)
+    publication_type = publication[0] if publication else classify_publication(text)
+    study_design = design[0] if design else inferred_design
+    design_key = design[1] if design else inferred_design
+    # A protocol's stated planned design is not completed trial evidence.
+    tier_type = "methods/protocol" if genre == "methods/protocol" else design_key
+    if tier_type == "unknown":
+        tier_type = genre if genre in EVIDENCE_WEIGHTS else "primary/other"
+    supplied_designs = {item[1] for item in supplied if item[1] in EVIDENCE_WEIGHTS
+                        and item[1] not in GENRES}
+    if design and supplied_designs and design_key not in supplied_designs:
+        tier_type = "unknown"
+    conflicts = metadata_conflicts(source)
+    if "publication_type" in conflicts:
+        publication_type = "unknown"
+    if "study_design" in conflicts:
+        study_design = "unknown"
+    return publication_type, study_design, tier_type
 
 
