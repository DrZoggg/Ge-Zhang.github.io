+def _type_key(value: str) -> str:
+    return re.sub(r"[\s_\-–—]+", " ", value.strip().casefold())
+
+
+GENRES = {name: name for name in (
+    "letter", "correspondence", "editorial", "commentary", "perspective",
+    "review", "journal article", "primary/other", "unknown",
+)}
+GENRES.update({"article": "journal article", "research article": "journal article",
+               "review article": "review", "letter to the editor": "letter",
+               "methods/protocol": "methods/protocol", "protocol": "methods/protocol",
+               "study protocol": "methods/protocol", "trial protocol": "methods/protocol"})
+DESIGNS = {_type_key(term): name for name, terms in PUBLICATION_TYPES
+           for term in (name, *terms)}
+DESIGNS.update({"rct": "randomized controlled trial", "case series": "case report/series",
+                "case report": "case report/series", "protocol": "methods/protocol",
+                "prospective cohort study": "cohort study",
+                "retrospective cohort study": "cohort study",
+                "randomized controlled clinical trial": "randomized controlled trial",
+                "randomised controlled clinical trial": "randomized controlled trial",
+                "unknown": "unknown"})
+DESIGNS.update({name: "non-empirical" for name in (
+    "none", "not applicable", "non empirical", "narrative argument",
+    "conceptual argument", "policy analysis", "no new empirical study",
+)})
+
+
+def _metadata_types(value: Any, *, design: bool = False) -> list[tuple[str, str]]:
+    """Recognize whole metadata values, never trial words inside free text.
+
+    Keep the supplied display wording; a list may contain a genre AND a design.
+    Caller metadata is an assertion, not independent scientific verification.
+    """
+    values = value if isinstance(value, (list, tuple)) else [value]
+    names = DESIGNS if design else {**DESIGNS, **GENRES}
+    return [(item.strip(), names[_type_key(item)]) for item in values
+            if isinstance(item, str) and _type_key(item) in names]
+
+
+def _text_genre(text: str) -> str:
+    labelled = extract_label(text, ("publication type", "publication_type", "article type"))
+    known = _metadata_types(labelled)
+    if known:
+        return known[0][1]
+    match = re.search(
+        r"(?:^|[.!?]\s+)(?:in\s+)?(?:this|our|the present)\s+"
+        r"(letter|correspondence|editorial|commentary|perspective|review)\b",
+        text, re.I,
+    )
+    return match[1].casefold() if match else ""
+
+
+def _text_design(text: str) -> str:
+    """Conservative self-design fallback, not a mention-based evidence grade.
+
+    Metadata is preferable. These rules cannot resolve arbitrary scientific
+    prose; ambiguous, quoted, prospective or other-study mentions stay unknown.
+    Negative RESULTS do not negate an affirmative description of the design.
+    """
+    lines = [line.strip() for line in text.splitlines() if line.strip()]
+    if not lines:
+        return "unknown"
+    own = re.compile(
+        r"^(?:in\s+)?(?:we\s+(?:conducted|performed|undertook|carried out)\b|"
+        r"(?:the\s+)?(?:authors|investigators|researchers)\s+"
+        r"(?:conduct(?:ed)?|perform(?:ed)?|develop(?:ed)?|validate[ds]?|"
+        r"evaluat(?:e[ds]?|ed)|report(?:ed)?|analy[sz](?:e[ds]?|ed))\b|"
+        r"(?:this|our|the present|the current)\s+"
+        r"(?:(?:randomi[sz]ed|controlled|clinical|prospective|retrospective|cohort|"
+        r"case-control|cross-sectional)\s+)*(?:study|trial|analysis)\b)", re.I)
+    negated = re.compile(
+        r"\b(?:no|not|never|without|rather than|instead of)\s+"
+        r"(?:(?:a|an|any|new|actual|completed|report|reporting|presenting|conduct|"
+        r"conducting|conducted|perform|performed|performing|undertaking|been)\s+)*$", re.I)
+    prospective = re.compile(r"\b(?:will|would|could|should|propos\w*|plan\w*|intend\w*|future)\b", re.I)
+    other = re.compile(r"\b(?:previously (?:published|reported|conducted)|prior|earlier|cited|"
+                       r"another|other|secondary analysis|reanalysis|et al|"
+                       r"(?:data|dataset|records)\s+from)\b", re.I)
+    title = lines[0]
+    protocol = re.search(
+        r"^(?:a |an )?(?:(?:study |trial )?protocol|proposal|design of)\b|"
+        r":\s*(?:a |an )?(?:study |trial )?protocol\b", title, re.I)
+    if protocol:
+        return "methods/protocol"
+    labelled = extract_label(text, ("study design", "study_design", "design"))
+    if known := _metadata_types(labelled, design=True):
+        return known[0][1]
+    for name, terms in PUBLICATION_TYPES:
+        for term in (name, *terms):
+            pattern = r"\b" + re.escape(term.strip()) + r"\b"
+            if name == "cohort study":
+                pattern = r"\b(?:(?:retrospective|prospective)\s+)?(?:longitudinal\s+)?cohorts?\b"
+            # A design explicitly in the TITLE is evidence; a topic-only title
+            # about trial reporting, future trials, reviews, etc. is not.
+            if (re.match(r"^(?:a |an )?" + pattern + r"(?:$|\s+(?:of|in|on|for|to)\b)", title, re.I)
+                    and not re.search(r"\b(?:reporting|registration|review|comment|perspective|"
+                                      r"needed|need|future|proposed|planned)\b", title, re.I)):
+                return name
+            for clause in re.split(r"[.!?;\n]+", text):
+                clause = clause.strip()
+                if not own.match(clause):
+                    continue
+                for match in re.finditer(pattern, clause, re.I):
+                    before = clause[:match.start()]
+                    if not (negated.search(before) or prospective.search(before)
+                            or other.search(before)):
+                        if name == "cohort study":
+                            if re.search(r"\bretrospective\b", match.group(0), re.I):
+                                return "retrospective cohort study"
+                            if re.search(r"\bprospective\b", match.group(0), re.I):
+                                return "prospective cohort study"
+                        return name
+    return "unknown"
+
