+def supplied_quality(source: dict[str, Any]) -> tuple[str, str] | None:
+    """Keep grades bundled with their own source's appraisal provenance."""
+    assessments = []
+    for assertion in source.get("_metadata_assertions") or [source]:
+        value = assertion.get("evidence_quality")
+        if not isinstance(value, str):
+            continue
+        grade = value.strip().casefold()
+        if grade not in {"high", "moderate", "contextual", "low", "unknown", "exclude"}:
+            continue
+        basis = assertion.get("quality_rationale") or assertion.get("evidence_quality_basis")
+        if isinstance(basis, str) and basis.strip():
+            rationale = "Caller-supplied assessment: " + basis.strip()
+        elif assertion.get("evidence_quality_verified") is True:
+            rationale = "Caller attests this supplied assessment was verified; no appraisal rationale supplied."
+        else:
+            rationale = "Caller-supplied assessment; no appraisal rationale or independent verification supplied."
+        assessments.append((grade, rationale))
+    if not assessments:
+        return None
+    if any(grade != "unknown" for grade, _ in assessments):
+        assessments = [(grade, reason) for grade, reason in assessments if grade != "unknown"]
+    if len({grade for grade, _ in assessments}) > 1:
+        return "unknown", "Conflicting caller-supplied quality assessments; see metadata_conflicts."
+    return assessments[0][0], "; ".join(dict.fromkeys(reason for _, reason in assessments))
 
 
